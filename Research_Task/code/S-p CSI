import numpy as np 
import matplotlib.pyplot as plt
from pathlib import Path

# 光速，单位 m/s
c = 3.0e8

# 载波频率：3 GHz
frequency = 3.0e9

# 波长 lambda = c / f
wavelength = c / frequency

# 路径损耗指数
eta = 4.0

# 防止发射机位置出现除零
epsilon = 0.05

print("波长 =", wavelength, "m")

region_size = 4.0
grid_size = 201

x = np.linspace(0.0, region_size, grid_size)
y = np.linspace(0.0, region_size, grid_size)

X, Y = np.meshgrid(x, y)

print("X shape:", X.shape)
print("Y shape:", Y.shape)

tx_x = 1.0
tx_y = 2.0

distance = np.sqrt(
    (X - tx_x) ** 2
    + (Y - tx_y) ** 2
)

print("distance shape:", distance.shape)
print("最小距离:", distance.min())
print("最大距离:", distance.max())

amplitude = 1.0 / (distance + epsilon) ** (eta / 2.0)

phase_unwrapped = -2.0 * np.pi * distance / wavelength

H = amplitude * np.exp(1j * phase_unwrapped)

H_amplitude = np.abs(H)
H_phase = np.angle(H)
H_real = np.real(H)
H_imag = np.imag(H)

print("H shape:", H.shape)
print("H dtype:", H.dtype)

print("是否包含 NaN:", np.isnan(H).any())
print("是否包含 Inf:", np.isinf(H).any())

print(
    "幅度是否正确:",
    np.allclose(np.abs(H), amplitude)
)

print(
    "复数关系是否正确:",
    np.allclose(
        H_real ** 2 + H_imag ** 2,
        H_amplitude ** 2
    )
)

amplitude_db = 20.0 * np.log10(
    H_amplitude / H_amplitude.max() + 1e-12
)

fig, axes = plt.subplots(
    2, 2,
    figsize=(12, 10),
    constrained_layout=True
)

extent = [0, region_size, 0, region_size]

# 1. 幅度图
image0 = axes[0, 0].imshow(
    amplitude_db,
    origin="lower",
    extent=extent,
    cmap="viridis",
    aspect="equal"
)
axes[0, 0].set_title("CSI Amplitude (dB)")
fig.colorbar(image0, ax=axes[0, 0], label="Relative amplitude (dB)")

# 2. 相位图
image1 = axes[0, 1].imshow(
    H_phase,
    origin="lower",
    extent=extent,
    cmap="twilight",
    vmin=-np.pi,
    vmax=np.pi,
    aspect="equal"
)
axes[0, 1].set_title("CSI Phase")
fig.colorbar(image1, ax=axes[0, 1], label="Phase (rad)")

# 为实部和虚部使用相同的颜色范围
complex_limit = max(
    np.abs(H_real).max(),
    np.abs(H_imag).max()
)

# 3. 实部图
image2 = axes[1, 0].imshow(
    H_real,
    origin="lower",
    extent=extent,
    cmap="RdBu_r",
    vmin=-complex_limit,
    vmax=complex_limit,
    aspect="equal"
)
axes[1, 0].set_title("Real Part of CSI")
fig.colorbar(image2, ax=axes[1, 0], label="Real(H)")

# 4. 虚部图
image3 = axes[1, 1].imshow(
    H_imag,
    origin="lower",
    extent=extent,
    cmap="RdBu_r",
    vmin=-complex_limit,
    vmax=complex_limit,
    aspect="equal"
)
axes[1, 1].set_title("Imaginary Part of CSI")
fig.colorbar(image3, ax=axes[1, 1], label="Imag(H)")

# 标出发射机
for axis in axes.flat:
    axis.scatter(
        tx_x,
        tx_y,
        marker="*",
        s=180,
        c="red",
        edgecolors="white",
        label="Tx"
    )
    axis.set_xlabel("x (m)")
    axis.set_ylabel("y (m)")
    axis.legend(loc="upper right")

# 在图片和文件名中记录当前实验参数，修改参数后不会覆盖旧图
frequency_ghz = frequency / 1e9
frequency_tag = f"{frequency_ghz:g}".replace(".", "p")
eta_tag = f"{eta:g}".replace(".", "p")

fig.suptitle(
    f"Single-path CSI: f={frequency_ghz:g} GHz, "
    f"eta={eta:g}, grid={grid_size}",
    fontsize=14
)

output_dir = Path("outputs")
output_dir.mkdir(parents=True, exist_ok=True)

filename = (
    f"single_path_f{frequency_tag}GHz_"
    f"eta{eta_tag}_grid{grid_size}.png"
)
save_path = output_dir / filename

fig.savefig(
    save_path,
    dpi=300,
    bbox_inches="tight",
    facecolor="white"
)

print("图片已保存到：", save_path.resolve())

plt.show()
